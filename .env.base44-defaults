# Development defaults for the Base44 sandbox.
#
# These are PLACEHOLDERS, not secrets: they point at the local PostgreSQL service
# declared in docker-compose.base44.yml. This file is listed FIRST in each
# service's env_file, so a real value uploaded to the Base44 dashboard (delivered
# via /run/base44/app.env) always overrides it.
#
# Local infrastructure only — never put real credentials here.

DATABASE_URL=postgres://autocontrole:autocontrole_dev@db:5432/autocontrole
UPLOAD_DIR=/app/uploads
